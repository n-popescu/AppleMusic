<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Lucent</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <key>NSAppleMusicUsageDescription</key>
    <string>Lucent plays music from your Apple Music account.</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>

    <!--
      Lets the app request Live Activities (Lock Screen / Dynamic Island).
      The Swift side that requests/updates/ends them
      (Services/NowPlayingRemoteController.swift, guarded by
      `#available(iOS 16.2, *)`) is code-ready, but actually *rendering*
      one needs a Widget Extension target this project doesn't add — see
      README.md -> "Live Activity / Widget — manual Xcode step required".
    -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!--
      Paste your MusicKit developer token (a signed JWT) here.
      See README.md -> "1. Generate a MusicKit developer token".
      Do NOT commit a real token to a public repo — for a real project,
      load this from an untracked local .plist or a build setting instead.
    -->
    <key>MusicKitDeveloperToken</key>
    <string>PASTE_YOUR_DEVELOPER_TOKEN_HERE</string>

    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
